# Copiá este archivo como .env y ajustá los valores.
# .env NO se sube a git (está en .gitignore).

# Puerto donde escucha la API
PORT=3000

# Ruta del archivo SQLite (relativa a la carpeta backend/)
DB_PATH=./escatt.db

# Origen permitido para CORS (el front de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173
