# Copiá este archivo como .env y ajustá los valores.
# .env NO se sube a git (está en .gitignore).

# Puerto donde escucha la API
PORT=3000

# Conexión a PostgreSQL. La base y el usuario deben existir de antemano
# (ver README / instrucciones de migración para crearlos en Ubuntu o Mac).
PGHOST=localhost
PGPORT=5432
PGUSER=escatt
PGPASSWORD=escatt_dev
PGDATABASE=escatt

# Origen permitido para CORS (el front de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173
